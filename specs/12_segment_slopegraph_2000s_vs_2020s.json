{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.20.1.json",
  "description": "Slopegraph comparing average cow-calf pair density in the 2000s versus 2020-2024.",
  "width": 520,
  "height": 400,
  "title": {
    "text": "How have breeding regions changed?",
    "subtitle": "Average cow-calf pairs per 100 km: 2000–2009 compared with 2020–2024."
  },
  "data": {
    "url": "data/whales_dryad_segments.csv"
  },
  "transform": [
    {
      "filter": "datum.Category == 'Cow-calf pairs'"
    },
    {
      "calculate": "datum.Year >= 2000 && datum.Year <= 2009 ? '2000–2009' : datum.Year >= 2020 && datum.Year <= 2024 ? '2020–2024' : null",
      "as": "Period"
    },
    {
      "filter": "datum.Period != null"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "per_100km",
          "as": "mean_per_100km"
        }
      ],
      "groupby": [
        "SegmentLabel",
        "Period"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2000–2009",
            "2020–2024"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "mean_per_100km",
          "type": "quantitative",
          "title": "Mean cow-calf pairs / 100 km"
        },
        "color": {
          "field": "SegmentLabel",
          "type": "nominal",
          "legend": {
            "title": "Coastal segment"
          }
        },
        "detail": {
          "field": "SegmentLabel"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 130,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2000–2009",
            "2020–2024"
          ]
        },
        "y": {
          "field": "mean_per_100km",
          "type": "quantitative"
        },
        "color": {
          "field": "SegmentLabel",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "SegmentLabel",
            "type": "nominal",
            "title": "Segment"
          },
          {
            "field": "Period",
            "type": "ordinal"
          },
          {
            "field": "mean_per_100km",
            "type": "quantitative",
            "format": ".2f",
            "title": "Mean pairs / 100 km"
          }
        ]
      }
    }
  ],
  "background": "white",
  "config": {
    "font": "Arial",
    "title": {
      "fontSize": 20,
      "anchor": "start"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}